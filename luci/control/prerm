#!/bin/sh

root=${IPKG_INSTROOT:-}
script="$root/etc/init.d/vpn-routing-restore"
if [ -z "$root" ]; then
    resume=$(jsonfilter -i /etc/vpn-routing/connection.json -e '@.resume' 2>/dev/null || :)
    if [ "$resume" = true ] || [ -e /var/run/vpn-routing/operation.json ] ||
        nft list tables 2>/dev/null | grep -Fxq 'table inet vpn_guard'; then
        echo "Disconnect VPN Routing in LuCI before removing or upgrading this package." >&2
        exit 1
    fi
    /etc/init.d/vpn-routing-subscription stop >/dev/null 2>&1 || :
    "$script" stop >/dev/null 2>&1 || :
fi
[ "${1:-}" != upgrade ] || exit 0
/bin/sh "$root/etc/rc.common" "$root/etc/init.d/vpn-routing-subscription" disable &&
    /bin/sh "$root/etc/rc.common" "$script" disable &&
    /bin/sh "$root/etc/rc.common" "$root/etc/init.d/vpn-routing-guard" disable
