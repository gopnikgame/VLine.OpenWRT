#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=09

start_service() {
    [ -f /etc/vpn-routing/connection.json ] || return 0
    procd_open_instance main
    procd_set_param command /usr/bin/lua /usr/lib/vpn-routing/restore.lua
    procd_set_param limits core="0 0"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
