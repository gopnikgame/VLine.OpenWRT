#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
    local config=/var/run/vpn-routing/xray.json
    local xray=/usr/libexec/vpn-routing/deps/xray
    local assets=/usr/share/vpn-routing/xray
    [ -s "$config" ] || return 1
    if [ ! -x "$xray" ]; then
        xray=/usr/bin/xray
        assets=/usr/share/xray
    fi
    if [ "$#" -ne 0 ]; then
        [ "$#" -eq 1 ] || return 1
        local pair=${1##*/}
        [ "$1" = "/etc/vpn-routing/geodata/$pair" ] || return 1
        printf '%s\n' "$pair" | grep -Eq '^[a-f0-9]{64}-[a-f0-9]{64}$' || return 1
        [ -s "$1/geoip.dat" ] && [ -s "$1/geosite.dat" ] || return 1
        assets=$1
    fi
    procd_open_instance main
    procd_set_param command "$xray" run -config "$config"
    procd_set_param env XRAY_LOCATION_ASSET="$assets"
    procd_set_param limits core="0 0"
    procd_close_instance
}
